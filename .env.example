# VMware NSX — Credential Template
# Copy to ~/.vmware-nsx/.env and fill in real passwords
#
# Easiest path: run `vmware-nsx init` for guided setup — it writes this file
# for you, stores the password grep-safe (b64:), and locks it to chmod 600.
#
# Manual setup — set permissions after creating .env:
#   cp .env.example ~/.vmware-nsx/.env
#   chmod 600 ~/.vmware-nsx/.env
#
# Naming convention: VMWARE_NSX_{TARGET_NAME_UPPER}_PASSWORD
#   - Replace hyphens with underscores
#   - Convert to UPPERCASE
#   - Example: target "nsx-prod" → VMWARE_NSX_NSX_PROD_PASSWORD
#
# Special characters (! ) * etc.) in the password are fine — NSX Manager
# authenticates via form-body POST, so they are sent literally.

# Passwords for targets defined in config.yaml
VMWARE_NSX_NSX_PROD_PASSWORD=
VMWARE_NSX_NSX_LAB_PASSWORD=

# Add more as needed — one per target in config.yaml
# VMWARE_NSX_NSX_DEV_PASSWORD=
